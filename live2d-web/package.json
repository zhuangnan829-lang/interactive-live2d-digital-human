    "prettier": "^3.8.1",
    "rimraf": "^6.1.3",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.2"
  },
  "optionalDependencies": {
    "fsevents": "*"
  }
