    "serve": "vite preview --port 5000 --host",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
