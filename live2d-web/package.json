    "build": "tsc --noEmit && vite build --mode development",
    "build:prod": "vite build",
    "assets:prepare": "node scripts/prepare-live2d-assets.mjs",
    "assets:verify": "node scripts/verify-live2d-assets.mjs",
    "test": "tsc --noEmit",
